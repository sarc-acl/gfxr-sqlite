      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 3,
      "text": "debugLabels will only be present\nat this level if they are queue\ndebug labels. They will have\nNULL values for\ncommandBufferRecordingId and all\nrenderPass/subpass recordingIds\nand will be present in the\nqueueDebugLabels post generated\nlookup table",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "P4-jrx5rl8_wq9jsFcG1u",
      "originalText": "debugLabels will only be present at this level if they are queue debug labels. They will have NULL values for commandBufferRecordingId and all renderPass/subpass recordingIds and will be present in the queueDebugLabels post generated lookup table",
      "lineHeight": 1.2,
      "baseline": 164,
      "index": "b37",
      "autoResize": true
    },
